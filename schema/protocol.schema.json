{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol manifest",
  "description": "protocol.json: lists a protocol's modules and is signed as one unit with them. Rules: docs/spec.md, Changeability.",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolId",
    "version",
    "owner",
    "reviewBy",
    "timezone",
    "departmentDefaults",
    "bookableHours",
    "baseModule",
    "optionalModules",
    "allowedCombinations",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "protocolId": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "owner": { "$ref": "#/$defs/text" },
    "reviewBy": { "$ref": "#/$defs/date" },
    "timezone": {
      "description": "IANA zone name. The only place a protocol's time zone is written.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z_]+(/[A-Za-z0-9_+-]+)+$"
    },
    "departmentDefaults": {
      "type": "object",
      "required": ["morningReminder", "eveningReminder", "reminderLead", "quietHours"],
      "additionalProperties": false,
      "properties": {
        "morningReminder": { "$ref": "#/$defs/clockTime" },
        "eveningReminder": { "$ref": "#/$defs/clockTime" },
        "reminderLead": {
          "description": "Elapsed hours and minutes, like the module schema's signedDuration but never negative.",
          "type": "string",
          "pattern": "^PT(?=[0-9])([0-9]{1,4}H)?([0-9]{1,4}M)?$"
        },
        "quietHours": { "$ref": "#/$defs/clockRange" }
      }
    },
    "bookableHours": {
      "description": "Appointment times the department books. The publish check samples every 15 minutes inside it.",
      "$ref": "#/$defs/clockRange"
    },
    "baseModule": {
      "type": "object",
      "required": ["moduleId", "version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "moduleId": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "optionalModules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["moduleId", "version", "sha256", "selectedAt"],
        "additionalProperties": false,
        "properties": {
          "moduleId": { "$ref": "#/$defs/id" },
          "version": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "selectedAt": { "enum": ["scheduling", "discharge"] }
        }
      }
    },
    "allowedCombinations": {
      "type": "object",
      "required": ["rule", "exactlyOneOf"],
      "additionalProperties": false,
      "properties": {
        "rule": { "const": "anySubset" },
        "exactlyOneOf": {
          "type": "array",
          "items": {
            "description": "appointmentTime: the modules' appliesWhen ranges split the day, so the appointment time matches exactly one. clinician: the clinician picks exactly one at QR creation.",
            "type": "object",
            "required": ["selectBy", "modules"],
            "additionalProperties": false,
            "properties": {
              "selectBy": { "enum": ["appointmentTime", "clinician"] },
              "modules": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    "signature": { "type": "string" },
    "source": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://\\S+$" } },
    "accessed": { "$ref": "#/$defs/date" },
    "note": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" },
    "clockTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "clockRange": {
      "description": "Local clock times from inclusive to exclusive. Wraps midnight when to is earlier than from: 23:00 to 05:00 includes 23:00, not 05:00.",
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/clockTime" },
        "to": { "$ref": "#/$defs/clockTime" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
